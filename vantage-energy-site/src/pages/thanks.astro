---
import Base from '../layouts/Base.astro';
---
<Base title="Request received" description="We received your request for a free compliance check.">
  <section class="dark plan-grid">
    <div class="wrap py-24 md:py-36">
      <h1 class="max-w-[14ch]">We got your request.</h1>
      <p class="lede mt-6 max-w-[44ch]">We'll look up your building in the City's records and get back to you.</p>
      <p class="mt-9"><a href="/" class="btn">Back to the homepage</a></p>
    </div>
  </section>
</Base>
