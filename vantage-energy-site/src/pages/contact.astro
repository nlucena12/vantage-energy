---
import Base from '../layouts/Base.astro';
import BookingForm from '../components/BookingForm.astro';
import Ph from '../components/Ph.astro';
import { site } from '../data/site.js';
---
<Base
  title="Book a free compliance check"
  description="Tell us about your Denver building. We look it up in the City's records and tell you where it stands with Energize Denver."
>
  <div class="dark plan-grid">
    <div class="wrap pb-32 pt-12 md:pb-40 md:pt-20">
      <h1 class="max-w-[14ch]">{site.cta}</h1>
      <p class="lede mt-5 max-w-[44ch]">Tell us about the building. We look it up in the City's records and get back to you.</p>
    </div>
  </div>

  <section class="wrap -mt-20 pb-16 md:-mt-24 md:pb-24">
    <div class="cols items-start gap-y-10">
      <div class="card card-lift col-span-full p-5 md:p-9 lg:col-span-7">
        <BookingForm id="contact" source="contact" />
      </div>

      <aside class="col-span-full lg:col-span-4 lg:col-start-9 lg:pt-28">
        <h2 class="text-[1.5rem]">Reach us directly</h2>
        <dl class="mt-5 grid gap-4">
          <div>
            <dt class="small font-semibold text-soft">Phone</dt>
            <dd><Ph text={site.phone} /></dd>
          </div>
          <div>
            <dt class="small font-semibold text-soft">Email</dt>
            <dd><Ph text={site.email} /></dd>
          </div>
          <div>
            <dt class="small font-semibold text-soft">Hours</dt>
            <dd><Ph text="business hours" /></dd>
          </div>
        </dl>
        <h2 class="mt-10 text-[1.5rem]">Not ready to book?</h2>
        <p class="mt-3 max-w-[36ch]">Answer a few yes-or-no questions and see what your building needs. <a href="/find-your-path/" class="font-semibold">Find your path</a></p>
      </aside>
    </div>
  </section>
</Base>
