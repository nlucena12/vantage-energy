---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Ph from '../components/Ph.astro';
import { site } from '../data/site.js';
---
<Base
  title="About"
  description="Vantage Energy handles Energize Denver compliance for small buildings in Denver, from the first walk-through to the final filing."
>
  <section class="wrap pb-14 pt-10 md:pb-20 md:pt-16">
    <div class="cols items-end gap-y-10">
      <div class="col-span-full lg:col-span-7">
        <h1 class="max-w-[14ch]">We take Energize Denver off your plate.</h1>
        <p class="lede measure mt-6">
          Vantage Energy handles Energize Denver compliance for small commercial and multifamily buildings in Denver,
          from the first walk-through to the final filing.
        </p>
      </div>
      <div class="col-span-full lg:col-span-5">
        <Photo name="about" ratio="3 / 2" sizes="(min-width: 64rem) 40vw, 100vw" eager />
      </div>
    </div>
  </section>

  <section class="section border-t-2 border-ink">
    <div class="wrap cols gap-y-12">
      <div class="col-span-full lg:col-span-6">
        <h2>Why we do this</h2>
        <div class="measure mt-5 grid gap-4">
          <p>Most small buildings don't have a facilities team. Reading the rules, finding contractors, and filing forms lands on an owner or manager who already has a full plate.</p>
          <p>We set up Vantage to take that whole job.</p>
        </div>
      </div>
      <div class="col-span-full lg:col-span-5 lg:col-start-8">
        <h2>How we work</h2>
        <div class="measure mt-5 grid gap-4">
          <p>You sign one agreement with us. We plan the project, bring in the right trades, manage the work, and file the result with the City.</p>
          <p>Work performed by licensed, insured contractors.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-wash">
    <div class="wrap">
      <h2>What that means for you</h2>
      <div class="cols mt-8 gap-y-8">
        <div class="col-span-full md:col-span-4 lg:col-span-4">
          <h3>One agreement</h3>
          <p class="mt-2 max-w-[36ch]">Your contract is with Vantage, not with a list of separate trades.</p>
        </div>
        <div class="col-span-full md:col-span-4 lg:col-span-4">
          <h3>One price</h3>
          <p class="mt-2 max-w-[36ch]">After the site walk you get one price for the whole job.</p>
        </div>
        <div class="col-span-full md:col-span-4 lg:col-span-4">
          <h3>One point of contact</h3>
          <p class="mt-2 max-w-[36ch]">You talk to us. We talk to the crews and to the City.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap cols gap-y-12">
      <div class="col-span-full lg:col-span-6">
        <h2>Who we are</h2>
        <p class="measure mt-5"><Ph text="team names, roles, short bios, and a photo" /></p>
      </div>
      <div class="col-span-full lg:col-span-5 lg:col-start-8">
        <h2>Where we work</h2>
        <p class="measure mt-5">Denver. Energize Denver applies to buildings in the City and County of Denver, and that's where we work.</p>
      </div>
    </div>
  </section>

  <section class="band section">
    <div class="wrap">
      <h2 class="max-w-[22ch]">Find out where your building stands.</h2>
      <p class="lede mt-5 max-w-[40ch]">Tell us about the building. We look it up in the City's records and get back to you.</p>
      <p class="mt-8"><a href="/contact/" class="btn w-full md:w-auto">{site.cta}</a></p>
    </div>
  </section>
</Base>
