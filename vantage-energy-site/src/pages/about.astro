---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Ph from '../components/Ph.astro';
import { site } from '../data/site.js';
---
<Base
  dock
  title="About"
  description="Vantage Energy handles Energize Denver compliance for small buildings in Denver, from the first walk-through to the final filing."
>
  <section class="hero">
    <div class="hero-media"><Photo name="about" sizes="100vw" eager /></div>
    <div class="wrap pb-16 pt-14 md:pb-24 md:pt-24">
      <h1 class="max-w-[16ch]">We take Energize Denver off your plate.</h1>
      <p class="lede mt-6 max-w-[50ch]">
        Vantage Energy handles Energize Denver compliance for small commercial and multifamily buildings in Denver,
        from the first walk-through to the final filing.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap cols gap-y-12">
      <div class="col-span-full lg:col-span-6">
        <h2>Why we do this</h2>
        <div class="measure mt-5 grid gap-4">
          <p class="lede">Most small buildings don't have a facilities team. Reading the rules, finding contractors, and filing forms lands on an owner or manager who already has a full plate.</p>
          <p class="lede">We set up Vantage to take that whole job.</p>
        </div>
      </div>
      <div class="col-span-full lg:col-span-5 lg:col-start-8">
        <div class="dark rounded-3xl p-6 shadow-lift md:p-8">
          <h2 class="text-[1.625rem] md:text-[1.875rem]">How we work</h2>
          <ul class="checks mt-5 font-semibold">
            <li>You sign one agreement with us.</li>
            <li>We plan the project and bring in the right trades.</li>
            <li>We manage the work and file the result with the City.</li>
          </ul>
          <p class="mt-6">Work performed by licensed, insured contractors.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-wash">
    <div class="wrap">
      <h2>What that means for you</h2>
      <ul class="mt-9 grid gap-4 md:grid-cols-3 md:gap-6">
        <li class="card p-6 md:p-7">
          <h3>One agreement</h3>
          <p class="mt-2 text-soft">Your contract is with Vantage, not with a list of separate trades.</p>
        </li>
        <li class="card p-6 md:p-7">
          <h3>One price</h3>
          <p class="mt-2 text-soft">After the site walk you get one price for the whole job.</p>
        </li>
        <li class="card p-6 md:p-7">
          <h3>One point of contact</h3>
          <p class="mt-2 text-soft">You talk to us. We talk to the crews and to the City.</p>
        </li>
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap cols gap-y-12">
      <div class="col-span-full lg:col-span-6">
        <h2>Who we are</h2>
        <p class="measure mt-5"><Ph text="team names, roles, short bios, and a photo" /></p>
      </div>
      <div class="col-span-full lg:col-span-5 lg:col-start-8">
        <h2>Where we work</h2>
        <p class="lede measure mt-5">Denver. Energize Denver applies to buildings in the City and County of Denver, and that's where we work.</p>
      </div>
    </div>
  </section>

  <section class="dark plan-grid section">
    <div class="wrap">
      <h2 class="max-w-[20ch]">Find out where your building stands.</h2>
      <p class="lede mt-5 max-w-[40ch]">Tell us about the building. We look it up in the City's records and get back to you.</p>
      <p class="mt-8"><a href="/contact/" class="btn w-full md:w-auto" data-dock-hide>{site.cta}</a></p>
    </div>
  </section>
</Base>
