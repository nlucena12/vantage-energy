---
import { site } from '../data/site.js';
const links = [
  { href: '/find-your-path/', label: 'Find your path' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];
const here = Astro.url.pathname.replace(/\/?$/, '/');
---
<header class="site-header">
  <div class="wrap flex items-center justify-between gap-4 py-3">
    <a href="/" class="brand" aria-label={`${site.name} home`}>
      <svg viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="8" fill="#ffc42e"/><path d="M7.5 9.5h5.2l3.3 9 3.3-9h5.2L18.2 24h-4.4z" fill="#15212a"/></svg>
      {site.name}
    </a>

    <nav aria-label="Main" class="hidden items-center gap-8 lg:flex">
      {links.map((l) => (
        <a href={l.href} class="nav-link" aria-current={here === l.href ? 'page' : undefined}>{l.label}</a>
      ))}
      <a href="/contact/" class="btn btn-compact">{site.cta}</a>
    </nav>

    <details class="relative lg:hidden">
      <summary class="menu-btn">Menu</summary>
      <nav aria-label="Main" class="menu-panel card card-lift">
        {links.map((l) => (
          <a href={l.href} aria-current={here === l.href ? 'page' : undefined}>{l.label}</a>
        ))}
        <a href="/contact/" class="btn mt-2">{site.cta}</a>
      </nav>
    </details>
  </div>
</header>
