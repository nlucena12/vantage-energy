---
import Ph from './Ph.astro';
import { site } from '../data/site.js';
const { dock = false } = Astro.props;
---
<footer class:list={['bg-deep text-paper', dock && 'pb-20 lg:pb-0']}>
  <div class="wrap cols gap-y-10 py-14 small">
    <div class="col-span-full md:col-span-4 lg:col-span-5">
      <p class="brand">
        <svg viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="8" fill="#ffc42e"/><path d="M7.5 9.5h5.2l3.3 9 3.3-9h5.2L18.2 24h-4.4z" fill="#15212a"/></svg>
        {site.name}
      </p>
      <p class="mt-4 max-w-[38ch] text-mist">Energize Denver compliance for small commercial and multifamily buildings in Denver.</p>
      <p class="mt-3 max-w-[38ch] text-mist">Work performed by licensed, insured contractors.</p>
    </div>
    <nav aria-label="Footer" class="col-span-2 grid content-start gap-3 font-semibold md:col-span-2 lg:col-span-3">
      <a href="/find-your-path/">Find your path</a>
      <a href="/about/">About</a>
      <a href="/contact/">Contact</a>
      <a href={site.cityUrl} rel="noopener">Energize Denver (City site)</a>
    </nav>
    <div class="col-span-2 grid content-start gap-3 md:col-span-2 lg:col-span-4">
      <p><Ph text={site.phone} /></p>
      <p><Ph text={site.email} /></p>
      <p class="text-mist">Denver, Colorado</p>
    </div>
    <p class="col-span-full border-t border-paper/15 pt-6 text-mist">
      &copy; {new Date().getFullYear()} <Ph text={site.legalName} />. Vantage Energy is a private company and is not part of the City and County of Denver.
    </p>
  </div>
</footer>
